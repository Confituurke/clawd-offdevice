    "set_difficulty": {
      "p": "select",
      "name": "Difficulty",
      "unique_id": "clawd_set_difficulty",
      "icon": "mdi:speedometer",
      "entity_category": "config",
      "command_topic": "clawd/config/set",
      "state_topic": "clawd/config",
      "options": [
        "easy",
        "normal",
        "hard"
      ],
      "command_template": "{\"DIFFICULTY\": {{ value | tojson }} }",
      "value_template": "{{ value_json.DIFFICULTY }}"
    },
    "set_pet_name": {
      "p": "text",
      "name": "Pet name",
      "unique_id": "clawd_set_pet_name",
      "icon": "mdi:rename",
      "entity_category": "config",
      "command_topic": "clawd/config/set",
      "state_topic": "clawd/config",
      "max": 12,
      "command_template": "{\"PET_NAME\": {{ value | tojson }} }",
      "value_template": "{{ value_json.PET_NAME }}"
    },
    "set_sound": {
      "p": "switch",
      "name": "Sound",
      "unique_id": "clawd_set_sound",
      "icon": "mdi:volume-high",
      "entity_category": "config",
      "command_topic": "clawd/config/set",
      "state_topic": "clawd/config",
      "payload_on": "{\"SOUND\":true}",
      "payload_off": "{\"SOUND\":false}",
      "value_template": "{{ 'ON' if value_json.SOUND else 'OFF' }}",
      "state_on": "ON",
      "state_off": "OFF"
    },
    "set_notify": {
      "p": "switch",
      "name": "Notifications",
