{
  "cmps": {
    "set_pet_name": {
      "p": "text",
      "name": "Pet name",
      "unique_id": "clawd_set_pet_name",
      "icon": "mdi:rename",
      "entity_category": "config",
      "command_topic": "clawd/config/set",
      "state_topic": "clawd/config",
      "max": 12,
      "command_template": "{\"PET_NAME\": {{ value | tojson }} }",
      "value_template": "{{ value_json.PET_NAME }}"
    },
    "set_sound": {
      "p": "switch",
      "name": "Sound",
      "unique_id": "clawd_set_sound",
      "icon": "mdi:volume-high",
      "entity_category": "config",
      "command_topic": "clawd/config/set",
      "state_topic": "clawd/config",
      "payload_on": "{\"SOUND\":true}",
      "payload_off": "{\"SOUND\":false}",
      "value_template": "{{ 'ON' if value_json.SOUND else 'OFF' }}",
      "state_on": "ON",
      "state_off": "OFF"
    },
    "set_notify": {
      "p": "switch",
      "name": "Notifications",
      "unique_id": "clawd_set_notify",
      "icon": "mdi:bell-ring",
      "entity_category": "config",
      "command_topic": "clawd/config/set",
      "state_topic": "clawd/config",
      "payload_on": "{\"NOTIFY\":true}",
      "payload_off": "{\"NOTIFY\":false}",
      "value_template": "{{ 'ON' if value_json.NOTIFY else 'OFF' }}",
      "state_on": "ON",
      "state_off": "OFF"
    },
    "set_switch_on_events": {
      "p": "switch",
      "name": "Show on big events",
      "unique_id": "clawd_set_switch_on_events",
      "icon": "mdi:monitor-eye",
      "entity_category": "config",
      "command_topic": "clawd/config/set",
      "state_topic": "clawd/config",
      "payload_on": "{\"SWITCH_ON_EVENTS\":true}",
      "payload_off": "{\"SWITCH_ON_EVENTS\":false}",
      "value_template": "{{ 'ON' if value_json.SWITCH_ON_EVENTS else 'OFF' }}",
      "state_on": "ON",
      "state_off": "OFF"
    },
    "set_mirror": {
      "p": "switch",
      "name": "Screen mirror",
      "unique_id": "clawd_set_mirror",
      "icon": "mdi:monitor-screenshot",
      "entity_category": "config",
      "command_topic": "clawd/config/set",
      "state_topic": "clawd/config",
      "payload_on": "{\"MIRROR\":true}",
      "payload_off": "{\"MIRROR\":false}",
      "value_template": "{{ 'ON' if value_json.MIRROR else 'OFF' }}",
      "state_on": "ON",
      "state_off": "OFF"
