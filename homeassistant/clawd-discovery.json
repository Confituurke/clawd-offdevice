{
  "dev": {
    "ids": [
      "clawd"
    ],
    "name": "Clawd",
    "mdl": "Virtual pet",
    "mf": "Clawd off-device"
  },
  "o": {
    "name": "clawd-hybrid-pet"
  },
  "state_topic": "clawd/state",
  "cmps": {
    "stage": {
      "p": "sensor",
      "name": "Stage",
      "unique_id": "clawd_stage",
      "icon": "mdi:egg-easter",
      "value_template": "{% set f = value.split(',') %}{% set st = f[1] | int %}{% set ev = f[2] | int %}{% set va = f[3] | int %}{% set old = (f[22] if f | length > 22 else '0') == '1' %}{{ 'Egg' if st == 0 else ('Passed away (old age)' if old else 'Dead') if st == 2 else (['Egg', 'Baby', 'Child', 'Teen', 'Adult', 'Elder', 'Legend'][ev] ~ ((' (well raised)' if va == 0 else ' (neglected)' if va == 2 else '') if ev in [4, 5] else '')) }}",
      "expire_after": 180
    },
    "food": {
      "p": "sensor",
      "name": "Food",
      "unique_id": "clawd_food",
      "icon": "mdi:food-drumstick",
      "value_template": "{% set f = value.split(',') %}{{ ((f[4] | int) / 100) | round(0) | int }}",
      "expire_after": 180,
      "unit_of_measurement": "%",
      "state_class": "measurement"
    },
    "happiness": {
      "p": "sensor",
      "name": "Happiness",
      "unique_id": "clawd_happiness",
      "icon": "mdi:emoticon-happy",
      "value_template": "{% set f = value.split(',') %}{{ ((f[5] | int) / 100) | round(0) | int }}",
      "expire_after": 180,
      "unit_of_measurement": "%",
      "state_class": "measurement"
    },
    "energy": {
      "p": "sensor",
      "name": "Energy",
      "unique_id": "clawd_energy",
      "icon": "mdi:lightning-bolt",
      "value_template": "{% set f = value.split(',') %}{{ ((f[6] | int) / 100) | round(0) | int }}",
      "expire_after": 180,
      "unit_of_measurement": "%",
      "state_class": "measurement"
    },
    "hygiene": {
      "p": "sensor",
      "name": "Hygiene",
      "unique_id": "clawd_hygiene",
      "icon": "mdi:shower",
      "value_template": "{% set f = value.split(',') %}{{ ((f[7] | int) / 100) | round(0) | int }}",
      "expire_after": 180,
      "unit_of_measurement": "%",
      "state_class": "measurement"
    },
    "health": {
      "p": "sensor",
      "name": "Health",
      "unique_id": "clawd_health",
      "icon": "mdi:heart-pulse",
      "value_template": "{% set f = value.split(',') %}{{ ((f[8] | int) / 100) | round(0) | int }}",
      "expire_after": 180,
      "unit_of_measurement": "%",
      "state_class": "measurement"
    },
    "age": {
      "p": "sensor",
      "name": "Age",
      "unique_id": "clawd_age",
      "icon": "mdi:cake-variant",
      "value_template": "{% set f = value.split(',') %}{{ ((f[15] | int) / 3600) | round(1) }}",
      "expire_after": 180,
      "unit_of_measurement": "h",
      "state_class": "measurement"
    },
    "poop": {
      "p": "sensor",
      "name": "Poop",
      "unique_id": "clawd_poop",
      "icon": "mdi:emoticon-poop",
      "value_template": "{% set f = value.split(',') %}{{ f[9] | int }}",
      "expire_after": 180
    },
    "care": {
      "p": "sensor",
      "name": "Care score",
      "unique_id": "clawd_care",
      "icon": "mdi:hand-heart",
      "value_template": "{% set f = value.split(',') %}{{ f[14] | int }}",
      "expire_after": 180,
      "state_class": "measurement"
    },
    "generation": {
      "p": "sensor",
      "name": "Generation",
      "unique_id": "clawd_generation",
      "icon": "mdi:family-tree",
      "value_template": "{% set f = value.split(',') %}{{ f[13] | int }}",
      "expire_after": 180
    },
    "asleep": {
      "p": "binary_sensor",
      "name": "Asleep",
      "unique_id": "clawd_asleep",
      "icon": "mdi:sleep",
      "value_template": "{% set f = value.split(',') %}{{ 'ON' if f[11] == '1' else 'OFF' }}",
      "expire_after": 180
    },
    "sick": {
      "p": "binary_sensor",
      "name": "Sick",
      "unique_id": "clawd_sick",
      "icon": "mdi:emoticon-sick",
      "value_template": "{% set f = value.split(',') %}{{ 'ON' if f[10] == '1' else 'OFF' }}",
      "expire_after": 180,
      "device_class": "problem"
    },
    "btn_feed": {
      "p": "button",
      "name": "Feed",
